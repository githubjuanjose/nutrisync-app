{
  "expo": {
    "name": "NutriSync",
    "slug": "nutrisync",
    "version": "0.21.0",
    "orientation": "portrait",
    "scheme": "nutrisync",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3b124e7e-e7e8-43ed-a54c-b660a07109dc",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "3b124e7e-e7e8-43ed-a54c-b660a07109dc"
      }
    },
    "splash": {
      "backgroundColor": "#FCF1EC",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutrisynccollective.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.nutrisynccollective.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FF6103"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriSync uses your photos so you can log a meal from a picture you already took.",
          "cameraPermission": "NutriSync uses the camera so you can photograph your meal and log it in one tap."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NutriSync uses your approximate location once to suggest your city during setup."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "NutriSync lee tu sueño, tu actividad y los datos de tu ciclo para rellenar tu día sin que lo teclees y ajustar las recomendaciones a lo que de verdad has hecho. Solo lectura: NutriSync no escribe nada en Salud.",
          "background": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}